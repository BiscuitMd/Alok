<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ========================================== -->
    <!-- LAYAR LOGIN (Tampil di awal)               -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUXANOX CALLER"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:shadowColor="#000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/editUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL Domain (http://ip:8081)"
            android:textColor="#FFF"
            android:textColorHint="#888"
            android:backgroundTint="#00E5FF"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/editKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key (rahasia123)"
            android:textColor="#FFF"
            android:textColorHint="#888"
            android:backgroundTint="#00E5FF"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="MASUK DASHBOARD"
            android:backgroundTint="#00E5FF"
            android:textColor="#000"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ========================================== -->
    <!-- LAYAR DASHBOARD (Sembunyi di awal)         -->
    <!-- ========================================== -->
    <ScrollView
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Anime 3D -->
            <!-- PASTIKAN LU NARUH GAMBAR banner_anime.jpg DI FOLDER res/drawable -->
            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="#333"
                android:src="@drawable/banner_anime"/> 
                <!-- KALAU GAMBAR BELUM ADA, HAPUS BARIS android:src DI ATAS -->

            <!-- Header Text 3D -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WELCOME OWNER"
                android:textSize="24sp"
                android:textStyle="bold|italic"
                android:textColor="#FFD700"
                android:shadowColor="#FF0000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <!-- Judul Dashboard -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONITORING BOT"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:layout_marginBottom="20dp"/>

            <!-- Statistik User -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="10dp">
                    <TextView
                        android:id="@+id/tvUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Users: 0"
                        android:textColor="#FFF"
                        android:gravity="center"
                        android:padding="16dp"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="10dp">
                    <TextView
                        android:id="@+id/tvPremium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Premium: 0"
                        android:textColor="#00FF00"
                        android:gravity="center"
                        android:padding="16dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Live Progress Call -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE STATUS CALLER:"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/progressCall"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF0000"/>

            <TextView
                android:id="@+id/tvCallStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Idle (0/0)"
                android:textColor="#AAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- List User -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR USER BOT:"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvUserList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat data user..."
                android:textColor="#AAA"
                android:fontFamily="monospace"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>