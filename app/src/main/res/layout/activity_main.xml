<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- ========================================== -->
    <!-- LAYAR LOGIN (Tampil di awal)               -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:background="#1A1A1A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Teks Login 3D Emas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUXANOX CALLER"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:shadowColor="#B8860B"
            android:shadowDx="4"
            android:shadowDy="4"
            android:shadowRadius="0"
            android:layout_marginBottom="40dp"/>

        <!-- Kolom Input ala Lego (Warna Abu Gelap & Emas) -->
        <EditText
            android:id="@+id/editUrl"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="URL Domain (http://ip:8081)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#2C2C2C"
            android:padding="15dp"
            android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/editKey"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="API Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#2C2C2C"
            android:padding="15dp"
            android:layout_marginBottom="30dp"/>

        <!-- Tombol 3D Emas -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="MASUK"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:backgroundTint="#FFD700"
            android:stateListAnimator="@null"
            android:elevation="8dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>

    <!-- ========================================== -->
    <!-- LAYAR DASHBOARD (Sembunyi di awal)         -->
    <!-- ========================================== -->
    <ScrollView
        android:id="@+id/layoutDashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Banner Anime (Nama File Tetap Sama) -->
            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="#333333"
                android:src="@drawable/banner_anime"/>

            <!-- WELCOME OWNER (Teks Putih Kertas 3D) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WELCOME OWNER"
                android:textSize="28sp"
                android:textStyle="bold|italic"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="1"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <!-- MONITORING BOT (Teks Emas 3D) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MONITORING BOT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:shadowColor="#B8860B"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:layout_marginBottom="20dp"/>

            <!-- Kotak Statistik ala Lego (Brick Abu-abu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#333333"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Users: 0"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:background="#333333"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvPremium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Premium: 0"
                        android:textColor="#00FF00"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Live Progress Call -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE STATUS CALLER:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/progressCall"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFD700"/> <!-- Progress Bar Emas -->

            <TextView
                android:id="@+id/tvCallStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Idle (0/0)"
                android:textColor="#AAAAAA"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"/>

            <!-- List User -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR USER BOT:"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvUserList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat data user..."
                android:textColor="#AAAAAA"
                android:background="#111111"
                android:padding="16dp"
                android:fontFamily="monospace"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>